+ui::ColorProviderKey PresetKey() {
+  ui::ColorProviderKey key;
+  key.user_color = kAccent;
+  key.scheme_variant = ui::ColorProviderKey::SchemeVariant::kNeutral;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+  return key;
+}
+
+TEST(ZenkaiClayColorMixerTest, MatchesSuppliedDarkSurfaces) {
+  ui::ColorProvider provider;
+  AddColorMixer(&provider, PresetKey());
+  EXPECT_EQ(kFrame, provider.GetColor(ui::kColorFrameActive));
+  EXPECT_EQ(kFrame, provider.GetColor(ui::kColorFrameInactive));
+  EXPECT_EQ(kToolbar, provider.GetColor(kColorToolbar));
+  EXPECT_EQ(kOmnibox, provider.GetColor(kColorLocationBarBackground));
+  EXPECT_EQ(kText, provider.GetColor(kColorOmniboxText));
+  EXPECT_EQ(kBackground, provider.GetColor(kColorNewTabPageBackground));
+  EXPECT_EQ(kText, provider.GetColor(kColorBookmarkBarForeground));
+  EXPECT_EQ(kSecondaryText,
+            provider.GetColor(kColorTabForegroundInactiveFrameActive));
+  EXPECT_EQ(kInactiveText,
+            provider.GetColor(kColorTabForegroundInactiveFrameInactive));
+  EXPECT_EQ(kAccent, provider.GetColor(ui::kColorSysStateFocusRing));
+}
+
+TEST(ZenkaiClayColorMixerTest, TextAndAccentHaveAccessibleContrast) {
+  EXPECT_GE(color_utils::GetContrastRatio(kText, kOmnibox), 4.5f);
+  EXPECT_GE(color_utils::GetContrastRatio(kInactiveText, kToolbar), 4.5f);
+  EXPECT_GE(color_utils::GetContrastRatio(kAccent, kBackground), 4.5f);
+  EXPECT_GE(color_utils::GetContrastRatio(kFrame, kAccent), 4.5f);
+}
+
+TEST(ZenkaiClayColorMixerTest, IncognitoKeepsThePalette) {
+  auto key = PresetKey();
+  key.user_color_source = ui::ColorProviderKey::UserColorSource::kGrayscale;
+  ui::ColorProvider provider;
+  AddColorMixer(&provider, key);
+  EXPECT_EQ(kFrame, provider.GetColor(ui::kColorFrameActive));
+  EXPECT_EQ(kToolbar, provider.GetColor(kColorToolbar));
+}
+
+TEST(ZenkaiClayColorMixerTest, OtherModesAndAccessibilityKeepTheirColors) {
+  for (int scenario = 0; scenario < 5; ++scenario) {
+    auto key = PresetKey();
+    switch (scenario) {
+      case 0:
+        key.user_color = SK_ColorBLUE;
+        break;
+      case 1:
+        key.scheme_variant = ui::ColorProviderKey::SchemeVariant::kTonalSpot;
+        break;
+      case 2:
+        key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+        break;
+      case 3:
+        key.contrast_mode = ui::ColorProviderKey::ContrastMode::kHigh;
+        break;
+      case 4:
+        key.forced_colors = ui::ColorProviderKey::ForcedColors::kSystem;
+        break;
+    }
+    ui::ColorProvider provider;
+    provider.AddMixer()[kColorToolbar] = {SK_ColorGREEN};
+    AddColorMixer(&provider, key);
+    EXPECT_EQ(SK_ColorGREEN, provider.GetColor(kColorToolbar)) << scenario;
+  }
+}
+
