+void AddColorMixer(ui::ColorProvider* provider,
+                   const ui::ColorProviderKey& key) {
+  // A neutral variant distinguishes the preset from a custom clay accent.
+  // Leave light mode, extension/app themes and accessibility colors intact.
+  if (key.user_color != kAccent ||
+      key.scheme_variant != ui::ColorProviderKey::SchemeVariant::kNeutral ||
+      key.color_mode != ui::ColorProviderKey::ColorMode::kDark ||
+      key.contrast_mode != ui::ColorProviderKey::ContrastMode::kNormal ||
+      key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone ||
+      key.custom_theme || key.app_controller) {
+    return;
+  }
+
+  // Keep the surfaces neutral instead of tinting them with the seed color.
+  // The same key is used by regular and incognito windows.
+  constexpr std::pair<ui::ColorId, SkColor> kColors[] = {
+      {ui::kColorFrameActive, kFrame},
+      {ui::kColorFrameInactive, kFrame},
+      {ui::kColorSysBase, kFrame},
+      {ui::kColorSysHeader, kFrame},
+      {ui::kColorSysHeaderInactive, kFrame},
+      {ui::kColorSysSurface, kFrame},
+      {ui::kColorSysSurface1, kToolbar},
+      {ui::kColorSysSurface2, kToolbar},
+      {ui::kColorSysSurface3, kOmnibox},
+      {ui::kColorSysSurface4, kOmnibox},
+      {ui::kColorSysSurface5, kOmnibox},
+      {ui::kColorSysBaseContainer, kToolbar},
+      {ui::kColorSysBaseContainerElevated, kOmnibox},
+      {ui::kColorSysNeutralContainer, kToolbar},
+      {ui::kColorSysSurfaceVariant, kOmnibox},
+      {ui::kColorSysDivider, kOmnibox},
+      {ui::kColorSysOnSurface, kText},
+      {ui::kColorSysOnSurfacePrimary, kText},
+      {ui::kColorSysOnSurfaceSecondary, kSecondaryText},
+      {ui::kColorSysOnSurfaceSubtle, kInactiveText},
+      {ui::kColorSysOnSurfaceVariant, kSecondaryText},
+      {ui::kColorSysPrimary, kAccent},
+      {ui::kColorSysOnPrimary, kFrame},
+      {ui::kColorSysPrimaryContainer, kSelection},
+      {ui::kColorSysOnPrimaryContainer, kText},
+      {ui::kColorSysSecondaryContainer, kSelection},
+      {ui::kColorSysOnSecondaryContainer, kText},
+      {ui::kColorSysTonalContainer, kSelection},
+      {ui::kColorSysOnTonalContainer, kText},
+      {ui::kColorSysStateFocusRing, kAccent},
+      {ui::kColorSysStateTextHighlight, kAccent},
+      {ui::kColorSysStateOnTextHighlight, kFrame},
+      {ui::kColorButtonBackgroundProminent, kAccent},
+      {ui::kColorButtonBackgroundProminentFocused, kAccent},
+      {ui::kColorButtonForegroundProminent, kFrame},
+      {ui::kColorTextfieldSelectionBackground, kAccent},
+      {ui::kColorTextfieldSelectionForeground, kFrame},
+      {kColorToolbar, kToolbar},
+      {kColorToolbarText, kText},
+      {kColorToolbarTextDefault, kText},
+      {kColorToolbarButtonText, kText},
+      {kColorToolbarButtonIcon, kInactiveText},
+      {kColorToolbarButtonIconHovered, kText},
+      {kColorToolbarButtonIconPressed, kText},
+      {kColorToolbarContentAreaSeparator, kOmnibox},
+      {kColorToolbarContentAreaSeparatorSolid, kOmnibox},
+      {kColorBookmarkBarBackground, kToolbar},
+      {kColorBookmarkBarForeground, kText},
+      {kColorLocationBarBackground, kOmnibox},
+      {kColorLocationBarBackgroundHovered, kOmnibox},
+      {kColorOmniboxResultsBackground, kOmnibox},
+      {kColorOmniboxResultsBackgroundHovered, kToolbar},
+      {kColorOmniboxResultsBackgroundSelected, kSelection},
+      {kColorOmniboxText, kText},
+      {kColorOmniboxTextDimmed, kInactiveText},
+      {kColorOmniboxResultsTextSelected, kText},
+      {kColorTabBackgroundActiveFrameActive, kToolbar},
+      {kColorTabBackgroundActiveFrameInactive, kToolbar},
+      {kColorTabBackgroundInactiveFrameActive, kFrame},
+      {kColorTabBackgroundInactiveFrameInactive, kFrame},
+      {kColorTabBackgroundInactiveHoverFrameActive, kOmnibox},
+      {kColorTabBackgroundInactiveHoverFrameInactive, kOmnibox},
+      {kColorTabBackgroundSelectedFrameActive, kSelection},
+      {kColorTabBackgroundSelectedFrameInactive, kSelection},
+      {kColorTabBackgroundSelectedHoverFrameActive, kSelection},
+      {kColorTabBackgroundSelectedHoverFrameInactive, kSelection},
+      {kColorTabForegroundActiveFrameActive, kText},
+      {kColorTabForegroundActiveFrameInactive, kText},
+      {kColorTabForegroundInactiveFrameActive, kSecondaryText},
+      {kColorTabForegroundInactiveFrameInactive, kInactiveText},
+      {kColorNewTabPageBackground, kBackground},
+      {kColorNewTabPageBackgroundOverride, kBackground},
+      {kColorNewTabPageHeader, kFrame},
+      {kColorNewTabPageText, kText},
+      {kColorNewTabPageLink, kAccent},
+      {kColorNewTabPageFocusRing, kAccent},
+  };
+  ui::ColorMixer& mixer = provider->AddMixer();
+  for (const auto& [id, color] : kColors) {
+    mixer[id] = {color};
+  }
+}
